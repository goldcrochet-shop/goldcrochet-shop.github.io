{
  "firestore": {
    "databaseId": "ai-studio-goldcrochetshop-0e84b9ac-6dbb-400f-9959-fc455c1c4776",
    "rules": "firestore.rules",
    "edition": "ENTERPRISE",
    "dataAccessMode": "FIRESTORE_NATIVE"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/cliente", "destination": "/cliente.html" },
      { "source": "/conta", "destination": "/cliente.html" },
      { "source": "/colecoes", "destination": "/colecoes.html" },
      { "source": "/pecas", "destination": "/pecas.html" },
      { "source": "/novidades", "destination": "/novidades.html" },
      { "source": "/casa-gold", "destination": "/casa-gold.html" }
    ],
    "cleanUrls": true
  }
}