rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email in ['goldcrochet.suporte@gmail.com', 'rossipereira2010@gmail.com']
      );
    }

    // Users collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId)
                    && incoming().id == userId
                    && incoming().email is string
                    && (incoming().role == 'customer' || (incoming().role == 'admin' && isAdmin()));
      allow update: if isValidId(userId) && isOwner(userId)
                    && incoming().id == userId
                    && incoming().email == existing().email
                    && incoming().role == existing().role;
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(orderId) && isSignedIn()
                    && incoming().userId == request.auth.uid
                    && incoming().total is number
                    && incoming().total >= 0
                    && incoming().items is list
                    && incoming().items.size() <= 100
                    && incoming().status in ['pendente', 'producao', 'enviado', 'entregue', 'cancelado'];
      allow update: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid && incoming().status == 'cancelado' && existing().status == 'pendente')
      );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Admins collection
    match /admins/{userId} {
      allow read: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow write: if isValidId(userId) && isAdmin();
    }

    // Newsletter subscriptions
    match /newsletter/{subId} {
      allow create: if isValidId(subId)
                    && incoming().email is string
                    && incoming().email.size() <= 128
                    && incoming().email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && incoming().active == true;
      allow read, list, update, delete: if isAdmin();
    }

    // Coupons collection (read by all for checkout discount validation, written by admin)
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings & Gift Program (read by all, written by admin)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products collection (read by all customers for store catalog, written by admin)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories collection (read by all for navigation, written by admin)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Analytics and site metrics
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if true;
    }

    // Test connection document for initial health checks
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
