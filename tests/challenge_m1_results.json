  "findings": [
    {
      "severity": "medium",
      "title": "gc:user-synced event is suppressed when customer is not authenticated with Firebase Auth or is offline",
      "description": "In js/shared-ui.js:889-970 (syncUserCrossDevice), document.dispatchEvent(\"gc:user-synced\") is located strictly after await setDoc(userRef, userPayload). If the user is unauthenticated or network is unavailable, setDoc throws permission-denied / network error and is caught by catch(err), which suppresses gc:user-synced from firing. UI listeners relying on gc:user-synced will not update locally unless authenticated.",
      "recommendation": "Dispatch gc:user-synced immediately when saveCustomer updates local state, or ensure local listeners listen to saveCustomer or localStorage updates in addition to remote sync."
    }
  ]
}